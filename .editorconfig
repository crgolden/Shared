# CS1591: Missing XML comment for publicly visible type or member — GenerateDocumentationFile is on
# for NuGet packaging metadata, but XML doc is not used in this codebase (AGENTS/COMMENTS.md), so
# per-member doc comments are never present (SA1600 above is already silenced for the same reason).
dotnet_diagnostic.CS1591.severity = none

# SA0001: XML comment analysis is disabled — a direct consequence of silencing CS1591/SA1600 above;
# StyleCop's documentation-rule analyzer can't run without doc-comment parsing enabled and treats
# that as an error otherwise. Suppressing is the documented companion fix for this combination.
dotnet_diagnostic.SA0001.severity = none

# XML doc is not used in this codebase (AGENTS/COMMENTS.md) — disable the full SA16xx doc-completeness
# family rather than let it fire on doc-comment fragments/partial doc left by removal.
